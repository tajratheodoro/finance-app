# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# typescript
*.tsbuildinfo

# generated Prisma client (rebuilt by `npm install` through postinstall)
/src/generated/

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# environment and secrets (.env.example is committed on purpose)
.env
.env.*
!.env.example
*.pem

# deployment
.vercel

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# editors and OS files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# AI assistant tooling installed into the project (not application code)
/.agents/
/.claude/
/.windsurf/
/skills-lock.json

# Visual references (not part of the app)
/references/
